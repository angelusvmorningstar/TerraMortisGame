        dot1_spec:     { type: 'string' },
        dot1_spec_skill: { type: 'string' },
        dot3_choice:   { type: 'string', enum: ['skill', 'merits'] },
        dot3_skill:    { type: 'string' },
        dot4_skill:    { type: 'string' },
