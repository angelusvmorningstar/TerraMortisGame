+const { test, expect } = require('@playwright/test');
+
+test('temporary crd.2 real-browser timing and routing probe', async ({ page }) => {
+  await page.goto('/index.html');
+  const initial = [
+    { _id: 'c1', challenger_character_name: 'Mammon', target_character_id: 'a1', target_character_name: 'Yusuf', roll_type: 'territory', created_at: '2026-08-22T10:11:12.345Z' },
+    { _id: 'c2', challenger_character_name: 'Ludica', target_character_id: 'a2', target_character_name: 'Livia', roll_type: 'social', created_at: '2026-08-22T10:11:12.345Z' },
+    { _id: 'c3', challenger_character_name: 'Belial', target_character_id: 'a1', target_character_name: 'Yusuf', roll_type: 'resistance', created_at: '2026-08-22T10:11:12.345Z' },
+  ];
+  await page.evaluate(async rows => {
+    document.body.innerHTML = '<div id="probe" class="tab active"></div><div id="resolve"></div>';
+    window.__queueRows = rows;
+    window.__mineCalls = 0;
+    window.__routes = [];
+    window.goTab = (...args) => window.__routes.push(args);
+    window.fetch = async url => {
+      if (String(url).includes('/api/contested_roll_requests/mine')) {
+        window.__mineCalls += 1;
+        return new Response(JSON.stringify(window.__queueRows), { status: 200, headers: { 'Content-Type': 'application/json' } });
+      }
+      return new Response('{}', { status: 200, headers: { 'Content-Type': 'application/json' } });
+    };
+    window.__queueMod = await import('/js/game/pending-queue.js');
+    window.__resolveMod = await import('/js/game/contested-resolve.js');
+    await window.__queueMod.initPendingQueue(document.getElementById('probe'), [
+      { _id: 'a1', name: 'Yusuf' }, { _id: 'a2', name: 'Livia' },
+    ]);
+    document.querySelector('[data-cq-id="c3"]').click();
+    window.__resolveMod.initContestedResolve(document.getElementById('resolve'), { challengeId: 'c3' });
+    document.getElementById('probe').classList.remove('active');
+    window.__queueRows = rows.filter(r => r._id !== 'c2');
+  }, initial);
+
+  await page.waitForTimeout(25_000);
+  expect(await page.evaluate(() => window.__mineCalls)).toBe(1);
+
+  await page.evaluate(() => document.getElementById('probe').classList.add('active'));
+  await page.waitForTimeout(10_500);
+  const resolved = await page.evaluate(() => ({
+    calls: window.__mineCalls,
+    route: window.__routes[0],
+    placeholder: document.getElementById('resolve').innerHTML,
+    html: document.getElementById('probe').innerHTML,
+    resolvedOpacity: getComputedStyle(document.querySelector('.cq-row-resolved')).opacity,
+  }));
+  expect(resolved.calls).toBe(2);
+  expect(resolved.route).toEqual(['contested-resolve', { challengeId: 'c3' }]);
+  expect(resolved.placeholder).toContain('c3');
+  expect(resolved.html).toContain('cq-row-resolved');
+  expect(resolved.html).not.toContain('data-cq-id="c2"');
+  expect(resolved.resolvedOpacity).toBe('0.5');
+
+  await page.waitForTimeout(10_500);
+  expect(await page.evaluate(() => document.getElementById('probe').innerHTML)).not.toContain('cq-row-resolved');
+});

