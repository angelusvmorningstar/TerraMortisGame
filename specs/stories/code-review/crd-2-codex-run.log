index 0000000000000000000000000000000000000000..79fc379aeda51453e98e0173baa62ac19d09253d
--- /dev/null
+++ b/tests/.tmp-crd2-codex-review.spec.js
@@ -0,0 +1,53 @@
+const { test, expect } = require('@playwright/test');
+
+test('temporary crd.2 real-DOM phone-width probe', async ({ page }) => {
+  await page.setViewportSize({ width: 390, height: 844 });
+  await page.goto('/index.html');
+
+  const result = await page.evaluate(async () => {
+    document.body.innerHTML = '<div id="probe" class="tab active"></div>';
+    const rows = [
+      {
+        _id: 'c1', challenger_character_name: 'Mammon',
+        target_character_id: 'a1', target_character_name: 'Yusuf Kalusicj',
+        roll_type: 'territory', created_at: '2026-08-22T10:11:12.345Z',
+      },
+      {
+        _id: 'c2', challenger_character_name: 'Ludica',
+        target_character_id: 'a2', target_character_name: 'Livia',
+        roll_type: 'social', created_at: '2026-08-22T10:11:12.345Z',
+      },
+    ];
+    window.fetch = async url => {
+      if (String(url).includes('/api/contested_roll_requests/mine')) {
+        return new Response(JSON.stringify(rows), { status: 200, headers: { 'Content-Type': 'application/json' } });
+      }
+      return new Response('{}', { status: 200, headers: { 'Content-Type': 'application/json' } });
+    };
+    const mod = await import('/js/game/pending-queue.js');
+    const root = document.getElementById('probe');
+    await mod.initPendingQueue(root, [
+      { _id: 'a1', name: 'Yusuf Kalusicj' },
+      { _id: 'a2', name: 'Livia', moniker: 'The Whisper' },
+    ]);
+    const row = root.querySelector('.cq-row');
+    const actions = row.querySelector('.oaq-queue-actions');
+    const name = row.querySelector('.oaq-queue-name');
+    const rr = row.getBoundingClientRect();
+    const ar = actions.getBoundingClientRect();
+    return {
+      html: root.innerHTML,
+      rowClientWidth: row.clientWidth,
+      rowScrollWidth: row.scrollWidth,
+      actionsRight: ar.right,
+      rowRight: rr.right,
+      nameWidth: name.getBoundingClientRect().width,
+    };
+  });
+
+  expect(result.html).toContain('Yusuf Kalusicj');
+  expect(result.html).toContain('The Whisper');
+  expect(result.rowScrollWidth).toBeGreaterThan(result.rowClientWidth);
+  expect(result.actionsRight).toBeGreaterThan(result.rowRight);
+  expect(result.nameWidth).toBe(0);
+});

