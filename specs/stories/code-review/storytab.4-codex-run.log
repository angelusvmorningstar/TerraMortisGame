// server/canon-write-monitor.js — runtime "zero canon writes" assertion (Story 4.1, AC #7).
//
// A defence layer that complements the credential (canon Atlas user cannot write),
// the surface (getCanonCollection exposes no write method), and the lexical guard
// (canon source contains no write call). This one watches the WIRE: it records
// every command the canon MongoClient issues and asserts none is a write.
//
// In Story 4.1 the helper ships with its own self-test (see canon-write-monitor.test.js).
// Its cross-suite use lands with the write-API stories (4.3+): a test that drives a
// wiki write path attaches this to the CANON client and asserts the canon
// connection stayed untouched while `tm_wiki` was written. Requires the client to be
// constructed with `{ monitorCommands: true }`.

// The MongoDB commands that mutate data or schema. Names are the wire command
// names (as they appear on a `commandStarted` event's `commandName`), NOT the
// driver method names — e.g. insertOne/insertMany and the collection-level
// bulkWrite all issue `insert`/`update`/`delete`. Two vectors that do NOT
// decompose and so must be named explicitly: the client-level MongoClient.bulkWrite
// (server 8.0+, driver v7+), which issues a single `bulkWrite` wire command; and
// `collMod`/`mapReduce`, which mutate schema / can persist output. The aggregate
// write vector ($out / $merge) surfaces on the wire as `aggregate` (a read name),
// so it is caught by pipeline inspection in classifyCommand below, recorded as the
// synthetic name `aggregateWrite`, which is a member of this set.
export const CANON_WRITE_COMMANDS = Object.freeze(new Set([
  'insert',
  'update',
  'delete',
  'findAndModify',
  'bulkWrite',
  'create',
  'createIndexes',
  'collMod',
  'mapReduce',
  'drop',
  'dropDatabase',
  'dropIndexes',
  'renameCollection',
  'aggregateWrite', // synthetic: an aggregate carrying an $out / $merge stage
]));

// Classify one commandStarted event into a recorded name. Almost always this is
// just event.commandName, but an aggregation that writes through an output stage
// ($out / $merge) reports commandName 'aggregate' — a read name — so we inspect
// the pipeline and record the synthetic write name 'aggregateWrite' instead. This
// is the one write vector a bare commandName check misses, and the same vector
// db.js excludes aggregate from the canon read surface to block.
function classifyCommand(event) {
  const name = event.commandName;
  const pipeline = event.command && event.command.pipeline;
  if (name === 'aggregate' && Array.isArray(pipeline)) {
    const writesOut = pipeline.some(
      (stage) => stage && (('$out' in stage) || ('$merge' in stage)),
    );
    if (writesOut) return 'aggregateWrite';
  }
  return name;
}

// Attach a command monitor to a MongoClient and return `{ commands, detach }`:
// `commands` is a live array of the (classified) command names the client issues,
// in order; `detach` removes the listener. The client must be created with
// `{ monitorCommands: true }` for `commandStarted` to fire.
//
// The `detach` handle exists because the cross-suite consumers (Story 4.3+ write
// tests) attach this to a SHARED canon client once per test; without a detach in
// `afterEach`, listeners accumulate across tests, eventually tripping Node's
// MaxListenersExceededWarning and keeping every prior test's array recording (the
// Story 4.1 review's deferred item 1, fixed here at its first real consumer).
// `detach` is idempotent: calling it more than once is a no-op.
export function attachCommandMonitor(client) {
  const commands = [];
  const listener = (event) => {
    commands.push(classifyCommand(event));
  };
  client.on('commandStarted', listener);
  let detached = false;
  const detach = () => {
    if (detached) return;
    detached = true;
    client.removeListener('commandStarted', listener);
  };
  return { commands, detach };
}

// Throw if any recorded command name is a write. Pass the array returned by
// attachCommandMonitor (or any array of command names). Fail-loud: the error
// lists exactly which write command(s) leaked, so a canon-write regression is a
// hard, named test failure rather than a silent leak.
export function assertNoCanonWrites(commandNames) {
  const writes = commandNames.filter((name) => CANON_WRITE_COMMANDS.has(name));
  if (writes.length) {
    throw new Error(
      `canon connection issued write command(s): ${writes.join(', ')} - canon must be read-only`,
    );
  }
}

// server/canon-write-monitor.test.js — Story 4.1 AC #7 self-test.
//
// Proves the monitor helper records commandStarted events and that
// assertNoCanonWrites actually FIRES on a write (discrimination) and passes on a
// read-only workload. No live Mongo: an EventEmitter stands in for the
// command-monitoring MongoClient (which is itself an EventEmitter).

import { test } from 'node:test';
import assert from 'node:assert/strict';
import { EventEmitter } from 'node:events';
import {
  attachCommandMonitor,
  assertNoCanonWrites,
  CANON_WRITE_COMMANDS,
} from './canon-write-monitor.js';

test('attachCommandMonitor records commandStarted command names in order', () => {
  const client = new EventEmitter();
  const { commands } = attachCommandMonitor(client);
  client.emit('commandStarted', { commandName: 'find' });
  client.emit('commandStarted', { commandName: 'aggregate' });
  client.emit('commandStarted', { commandName: 'ping' });
  assert.deepEqual(commands, ['find', 'aggregate', 'ping']);
});

test('Story 4.3: detach removes the listener (no accumulation across tests) and is idempotent', () => {
  const client = new EventEmitter();
  const { commands, detach } = attachCommandMonitor(client);
  client.emit('commandStarted', { commandName: 'find' });
  assert.equal(client.listenerCount('commandStarted'), 1, 'listener attached');
  detach();
  assert.equal(client.listenerCount('commandStarted'), 0, 'listener removed on detach');
  // after detach, further commands are NOT recorded (the cross-suite afterEach use).
  client.emit('commandStarted', { commandName: 'insert' });
  assert.deepEqual(commands, ['find'], 'no recording after detach');
  // idempotent: a second detach is a harmless no-op.
  assert.doesNotThrow(() => detach());
  assert.equal(client.listenerCount('commandStarted'), 0);
});

test('assertNoCanonWrites passes for a read-only workload', () => {
  assert.doesNotThrow(() => assertNoCanonWrites(['find', 'findOne', 'count', 'aggregate', 'ping']));
});

test('assertNoCanonWrites (discrimination) THROWS on any write command, naming it', () => {
  assert.throws(
    () => assertNoCanonWrites(['find', 'insert']),
    /issued write command\(s\): insert/,
  );
  assert.throws(
    () => assertNoCanonWrites(['update', 'delete']),
    /update, delete/,
  );
});

test('assertNoCanonWrites end-to-end via the monitor catches a wire write', () => {
  const client = new EventEmitter();
  const { commands: names } = attachCommandMonitor(client);
  client.emit('commandStarted', { commandName: 'find' });
  client.emit('commandStarted', { commandName: 'insert' }); // a canon write leak
  assert.throws(() => assertNoCanonWrites(names), /insert/);
});

test('CANON_WRITE_COMMANDS covers the mutating wire commands and is frozen', () => {
  // Includes the vectors a naive CRUD list misses: the client-level bulkWrite wire
  // command (does not decompose into insert/update/delete on driver v7+), and the
  // schema/output-mutating collMod / mapReduce.
  for (const cmd of ['insert', 'update', 'delete', 'findAndModify', 'bulkWrite',
    'collMod', 'mapReduce', 'drop', 'createIndexes', 'renameCollection']) {
    assert.ok(CANON_WRITE_COMMANDS.has(cmd), `${cmd} must be treated as a write`);
  }
  // Reads are not writes. Note `aggregate` (the bare read name) is NOT a write -
  // an aggregate that writes is caught by pipeline inspection and recorded as the
  // synthetic 'aggregateWrite' (asserted below), so the bare name stays a read.
  for (const cmd of ['find', 'aggregate', 'count', 'distinct', 'ping', 'getMore']) {
    assert.ok(!CANON_WRITE_COMMANDS.has(cmd), `${cmd} must NOT be treated as a write`);
  }
  assert.ok(Object.isFrozen(CANON_WRITE_COMMANDS));
});

test('discrimination: a client-level bulkWrite wire command is caught', () => {
  const client = new EventEmitter();
  const { commands: names } = attachCommandMonitor(client);
  client.emit('commandStarted', { commandName: 'find' });
  client.emit('commandStarted', { commandName: 'bulkWrite' }); // does not decompose
  assert.throws(() => assertNoCanonWrites(names), /bulkWrite/);
});

test('discrimination: an aggregate with an $out / $merge stage is caught as a write', () => {
  const client = new EventEmitter();
  const { commands: names } = attachCommandMonitor(client);
  // A pure read aggregate stays a read...
  client.emit('commandStarted', { commandName: 'aggregate', command: { pipeline: [{ $match: {} }] } });
  assert.doesNotThrow(() => assertNoCanonWrites(names));
  // ...but one that persists via $out is recorded as a write and caught.
  client.emit('commandStarted', { commandName: 'aggregate', command: { pipeline: [{ $match: {} }, { $out: 'leak' }] } });
  assert.deepEqual(names, ['aggregate', 'aggregateWrite']);
  assert.throws(() => assertNoCanonWrites(names), /aggregateWrite/);
});

test('discrimination: an aggregate with a $merge stage is caught as a write', () => {
  const client = new EventEmitter();
  const { commands: names } = attachCommandMonitor(client);
  client.emit('commandStarted', { commandName: 'aggregate', command: { pipeline: [{ $merge: { into: 'leak' } }] } });
  assert.deepEqual(names, ['aggregateWrite']);
  assert.throws(() => assertNoCanonWrites(names), /aggregateWrite/);
});


