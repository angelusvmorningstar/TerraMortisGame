async function fetchAndMergeStoryTabDowntimes(char, subs, cycles) {
  try {
    const { downtimes, chapters } = await apiGet(`/api/downtime_submissions/story-tab?character_id=${char._id}`);
    return [[...subs, ...downtimes], [...cycles, ...chapters]];
  } catch {
    return [subs, cycles];
  }
}

